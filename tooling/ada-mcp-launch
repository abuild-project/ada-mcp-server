#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

# Start one existing Ada MCP image over STDIO with explicitly shared roots.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ada-mcp-launch --image IMAGE --root ABS_DIR [--root ABS_DIR ...]
                      [--docker-host ENDPOINT | --docker-context NAME]
                      [--uid UID --gid GID] [--name NAME] [--check]
                      [--update-channel auto|stable|prerelease|off]
                      [--update-cache ABS_DIR] [--python ABS_EXECUTABLE]

The image must already exist locally and target linux/amd64. Each selected
directory is mounted read-only at the same absolute path. The caller's UID
and GID are used unless explicitly overridden. No image is pulled or built.
Docker's existing host/context configuration is retained unless one explicit
endpoint/context override is provided. --check prints metadata without starting
a server or checking the network. --python pins the host Python 3.11+ used
for advisories; older configurations fall back to python3 on PATH.
In normal mode stdout contains only the MCP protocol.
EOF
}

fail() {
    printf 'ada-mcp-launch: %s\n' "$*" >&2
    exit 2
}

require_value() {
    if [[ $# -lt 2 || -z "$2" ]]; then
        fail "$1 requires a nonempty value"
    fi
}

probe_python() (
    # Keep the deadline independent of Python startup and wrapper behavior.
    probe_output="$(mktemp "${TMPDIR:-/tmp}/ada-mcp-python.XXXXXXXX" 2>/dev/null)" || exit 1
    trap 'rm -f -- "$probe_output" 2>/dev/null' EXIT
    "$advisory_python" -I -c \
        'import sys; print(".".join(map(str, sys.version_info[:3]))); sys.exit(sys.version_info < (3, 11))' \
        </dev/null >"$probe_output" 2>/dev/null &
    probe_pid=$!
    remaining=20
    while kill -0 "$probe_pid" 2>/dev/null; do
        if [[ "$remaining" -eq 0 ]]; then
            kill -KILL "$probe_pid" 2>/dev/null || :
            wait "$probe_pid" 2>/dev/null || :
            exit 124
        fi
        # Each foreground sleep is reaped; no background watchdog survives.
        sleep 0.1
        remaining=$((remaining - 1))
    done
    probe_status=0
    wait "$probe_pid" 2>/dev/null || probe_status=$?
    [[ "$probe_status" -eq 0 ]] || exit 1
    probe_bytes="$(wc -c <"$probe_output" 2>/dev/null)" || exit 1
    [[ "$probe_bytes" -le 65 ]] || exit 1
    version=''
    IFS= read -r -n 65 version <"$probe_output" || exit 1
    [[ "$probe_bytes" -eq $((${#version} + 1)) && ${#version} -le 64 &&
        "$version" =~ ^([3-9]|[1-9][0-9]+)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || exit 1
    major="${BASH_REMATCH[1]}"
    minor="${BASH_REMATCH[2]}"
    # Canonical decimal components permit this minimum check without overflow.
    [[ "$major" != 3 || ( ${#minor} -ge 2 && "$minor" != 10 ) ]] || exit 1
    printf '%.64s' "$version"
    exit 0
)

image=''
docker_host=''
docker_context=''
runtime_uid="$(id -u)"
runtime_gid="$(id -g)"
container_name=''
check_only=false
update_channel="${ADA_MCP_UPDATE_CHANNEL:-auto}"
update_channel_explicit=false
update_cache="${ADA_MCP_UPDATE_CACHE:-}"
advisory_python=''
roots=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --image)
            require_value "$@"
            [[ -z "$image" ]] || fail '--image may be supplied only once'
            image="$2"
            shift 2
            ;;
        --root)
            require_value "$@"
            root="$2"
            [[ "$root" == /* ]] || fail '--root must be an absolute directory'
            case "$root" in
                *','*|*'"'*|*$'\n'*|*$'\r'*)
                    fail '--root cannot contain comma, double quote or newline'
                    ;;
            esac
            case "$root/" in
                */../*|*/./*) fail '--root cannot contain . or .. components' ;;
            esac
            while [[ "$root" != / && "$root" == */ ]]; do
                root="${root%/}"
            done
            [[ "$root" != / ]] || fail 'sharing the entire filesystem is not supported'
            # Component-wise overlap, not a blanket /opt or /usr exclusion.
            for reserved in /opt/ada-mcp /bin /sbin /lib /lib64 /usr/bin /usr/sbin \
                /usr/lib /usr/lib64 /usr/libexec /usr/local/bin /usr/local/sbin \
                /usr/local/lib /usr/local/lib64 /usr/local/libexec /etc; do
                if [[ "$root" == "$reserved" || "$root" == "$reserved/"* ||
                    "$reserved" == "$root/"* ]]; then
                    fail "root overlaps a reserved runtime path: $reserved"
                fi
            done
            [[ -d "$root" ]] || fail "root is not an existing directory: $root"
            physical="$(cd -P -- "$root" && pwd -P)" || fail 'cannot resolve physical root'
            [[ "$physical" != / && "$physical" == "$root" ]] ||
                fail '--root must be a physical absolute directory without symlink aliases'
            duplicate=false
            if [[ ${#roots[@]} -gt 0 ]]; then
                for selected in "${roots[@]}"; do
                    if [[ "$selected" == "$root" ]]; then duplicate=true; fi
                done
            fi
            if [[ "$duplicate" == false ]]; then roots+=("$root"); fi
            shift 2
            ;;
        --docker-host)
            require_value "$@"
            [[ -z "$docker_host" ]] || fail '--docker-host may be supplied only once'
            docker_host="$2"
            shift 2
            ;;
        --docker-context)
            require_value "$@"
            [[ -z "$docker_context" ]] || fail '--docker-context may be supplied only once'
            docker_context="$2"
            shift 2
            ;;
        --uid)
            require_value "$@"
            runtime_uid="$2"
            shift 2
            ;;
        --gid)
            require_value "$@"
            runtime_gid="$2"
            shift 2
            ;;
        --name)
            require_value "$@"
            [[ -z "$container_name" ]] || fail '--name may be supplied only once'
            container_name="$2"
            shift 2
            ;;
        --check)
            check_only=true
            shift
            ;;
        --update-channel)
            require_value "$@"
            update_channel="$2"
            update_channel_explicit=true
            shift 2
            ;;
        --update-cache)
            require_value "$@"
            [[ "$2" == /* ]] || fail '--update-cache must be absolute'
            update_cache="$2"
            shift 2
            ;;
        --python)
            require_value "$@"
            [[ -z "$advisory_python" ]] || fail '--python may be supplied only once'
            [[ "$2" == /* ]] || fail '--python must be an absolute executable path'
            advisory_python="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

case "$update_channel" in
    auto|stable|prerelease|off) ;;
    *)
        if [[ "$check_only" == true || "$update_channel_explicit" == true ]]; then
            fail 'invalid update channel; use auto, stable, prerelease or off'
        fi
        printf '%s\n' 'ada-mcp-launch: Invalid inherited update channel; advisory disabled. Use auto, stable, prerelease or off. MCP remains usable.' >&2
        update_channel=off
        ;;
esac

[[ -n "$image" ]] || fail '--image is required'
[[ ${#roots[@]} -gt 0 ]] || fail 'at least one --root is required'
[[ -z "$docker_host" || -z "$docker_context" ]] ||
    fail '--docker-host and --docker-context are mutually exclusive'
for identity in "$runtime_uid" "$runtime_gid"; do
    [[ "$identity" =~ ^[1-9][0-9]*$ ]] || fail 'UID and GID must be nonzero decimal integers'
    [[ ${#identity} -le 10 ]] || fail 'UID or GID is outside the supported numeric range'
    [[ "$identity" -le 4294967294 ]] || fail 'UID or GID is outside the supported numeric range'
done
if [[ -n "$container_name" ]]; then
    [[ "$container_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] ||
        fail 'invalid container name'
fi
command -v docker >/dev/null 2>&1 || fail 'docker is not available on PATH'

docker_command=(docker)
if [[ -n "$docker_host" || -n "$docker_context" ]]; then
    docker_command=(env -u DOCKER_HOST -u DOCKER_CONTEXT -u DOCKER_TLS
        -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH docker)
    if [[ -n "$docker_host" ]]; then
        docker_command+=(--host "$docker_host")
    else
        docker_command+=(--context "$docker_context")
    fi
fi

resolved_image="$("${docker_command[@]}" image inspect --format '{{.Id}}' -- "$image")" ||
    fail 'the selected image is unavailable; no image was pulled'
[[ "$resolved_image" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'Docker did not return one image ID'
platform="$("${docker_command[@]}" image inspect --format '{{.Os}}/{{.Architecture}}' -- "$resolved_image")"
[[ "$platform" == linux/amd64 ]] || fail "expected linux/amd64 image, found $platform"

notice=''
python_status=disabled
python_version=''
if [[ -z "$advisory_python" ]]; then
    advisory_python="$(command -v python3)" || advisory_python=''
fi
# An advisory must never stop the server or write prose to protocol stdout.
case "$update_channel" in
    auto|stable|prerelease)
        python_status=unavailable-or-unsupported
        if [[ -n "$advisory_python" ]] && python_version="$(probe_python)"; then
            python_status=supported
        else
            if [[ $? -eq 124 ]]; then
                python_status=timed-out
                printf '%s\n' 'ada-mcp-launch: Update advisory unavailable: host Python probe exceeded its two-second deadline. Review --python; MCP remains usable.' >&2
            else
                printf '%s\n' 'ada-mcp-launch: Update advisory unavailable: host Python 3.11+ required; review --python or python3 on PATH. MCP remains usable.' >&2
            fi
        fi
        if [[ "$check_only" == false && "$python_status" == supported ]]; then
            script_root="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || script_root=''
            update_command=("$advisory_python" -I "$script_root/release_updates.py" snapshot
                --channel "$update_channel")
            if [[ -n "$update_cache" ]]; then update_command+=(--cache "$update_cache"); fi
            if ! notice="$("${update_command[@]}" </dev/null 2>/dev/null)" ||
                [[ ${#notice} -gt 2048 ]]; then
                notice=''
                printf '%s\n' 'ada-mcp-launch: Update advisory failed; check the selected Python and verified runtime helpers. MCP remains usable.' >&2
            fi
        fi
        ;;
    off) ;;
esac

if [[ "$check_only" == true ]]; then
    printf 'image=%s\nplatform=%s\nuid=%s\ngid=%s\nroots=%s\n' \
        "$resolved_image" "$platform" "$runtime_uid" "$runtime_gid" "${#roots[@]}"
    printf 'update_channel=%s\npython=%s\npython_status=%s\npython_version=%.64s\n' \
        "$update_channel" "$advisory_python" "$python_status" "$python_version"
    [[ "$python_status" == supported || "$python_status" == disabled ]] || exit 2
    exit 0
fi

arguments=(run --platform linux/amd64 --pull never --rm -i
    --label ada-mcp-generic=1 --user "$runtime_uid:$runtime_gid"
    --network none --read-only --cap-drop ALL --security-opt no-new-privileges
    --tmpfs /tmp:rw,nosuid,nodev,noexec
    --tmpfs "/home/ada-mcp:rw,nosuid,nodev,uid=$runtime_uid,gid=$runtime_gid,mode=0700"
    --env ADA_PROJECT_ROOT= --env ADA_PROJECT_FILE=
    --env "ADA_MCP_UPDATE_NOTICE=$notice"
    --env 'ADA_PROJECT_SCENARIO_VARIABLES={}')
if [[ -n "$container_name" ]]; then arguments+=(--name "$container_name"); fi
for root in "${roots[@]}"; do
    arguments+=(--mount "type=bind,src=$root,dst=$root,readonly")
done
arguments+=(--workdir "${roots[0]}" "$resolved_image")
exec "${docker_command[@]}" "${arguments[@]}"
